#!/bin/bash

# Plugin Manager backend. The overlay never touches the system itself: every
# command here prints exactly one JSON document on stdout.
# The actions are thin wrappers over the stock omarchy-plugin-* binaries, so
# cloning, validation, rollback and shell rescans stay Omarchy's business.
#
#   plugin-manager list
#   plugin-manager check [id] [--if-stale SECONDS] [--notify]
#   plugin-manager review <id>
#   plugin-manager update <id>
#   plugin-manager remove <id>
#   plugin-manager add <git-url>
#   plugin-manager enable <id>
#   plugin-manager disable <id>
#   plugin-manager suggest-key <id>
#   plugin-manager keycheck <keys> [id]
#   plugin-manager bind <id> <keys> [--replace]
#   plugin-manager unbind <id>
#   plugin-manager export [file]
#   plugin-manager import <file> [--dry-run]
#   plugin-manager run --label L --id ID --kind K -- <command...>
#
# Only git plugins are managed: the checkouts `omarchy plugin add` makes in
# ~/.config/omarchy/plugins. Clones of built-ins, folders dropped in by hand
# and symlinks are left alone, as are the built-in omarchy.* plugins. The
# manager lists itself too, so it can be checked and updated, but it will not
# remove itself or switch itself off.

set -uo pipefail

SELF_ID="io.github.kimm-stensborg.plugin-manager"
PLUGINS_DIR="$HOME/.config/omarchy/plugins"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/plugin-manager"
CACHE="$CACHE_DIR/updates.json"
MAX_COMMITS=20
MAX_DIFF_LINES=3000
PLUGIN_GLYPH=$'\U000f0431'

# The same non-interactive git as omarchy-plugin-update: a fetch has to fail
# rather than wait for a password nobody can type into an overlay.
export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}"

# Key combinations, shared by every jq program that reads or writes one.
# combo turns "SUPER + SHIFT + L" into the modifier mask and key hyprctl
# reports; keylabel turns that back into the one spelling this file writes.
JQ_KEYS='
def combo:
  {"SUPER": 64, "MOD": 64, "WIN": 64, "LOGO": 64, "SHIFT": 1, "CTRL": 4, "CONTROL": 4, "ALT": 8, "MOD1": 8} as $mods
  | [split("+")[] | gsub("^\\s+|\\s+$"; "") | ascii_upcase | select(. != "")] as $parts
  | [$parts[] | select($mods[.] == null)] as $keys
  | { modmask: ([$parts[] | $mods[.] // empty] | unique | add // 0),
      key: ($keys | last // ""),
      single: (($keys | length) == 1) };
def keylabel:
  [ (if ((.modmask / 64) | floor) % 2 == 1 then "SUPER" else empty end),
    (if ((.modmask / 4) | floor) % 2 == 1 then "CTRL" else empty end),
    (if .modmask % 2 == 1 then "SHIFT" else empty end),
    (if ((.modmask / 8) | floor) % 2 == 1 then "ALT" else empty end),
    .key ] | join(" + ");
def takenby($live; $c):
  [($live // [])[] | select(.modmask == $c.modmask and (.key | ascii_upcase) == $c.key)];
'

# ------------------------------------------------------------------ output

# reply <ok> <message> [output] [extra-json]
reply() {
  local extra="${4:-}"
  [[ -n $extra ]] || extra='{}'
  jq -cn --argjson ok "$1" --arg message "$2" --arg output "${3:-}" --argjson extra "$extra" \
    '{ok: $ok, message: $message, output: $output} + $extra'
}

fail() {
  reply false "$1"
  exit 1
}

last_line() {
  awk 'NF { line = $0 } END { print line }' <<<"$1"
}

# plural <n> <word> -- "1 file", "3 files".
plural() {
  if (($1 == 1)); then echo "1 $2"; else echo "$1 $2s"; fi
}

# ------------------------------------------------------------------- ids

valid_id() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != *..* ]]
}

# A real folder holding a git checkout. A symlink is a working copy that lives
# somewhere else, even when the folder it points to is a checkout.
is_git_plugin() {
  [[ -d $PLUGINS_DIR/$1/.git && ! -L $PLUGINS_DIR/$1 ]]
}

# A plugin the manager may act on: any git plugin, the manager included.
require_managed() {
  local id="$1"
  [[ -n $id ]] || fail "a plugin id is required"
  valid_id "$id" || fail "invalid plugin id '$id'"
  [[ -e $PLUGINS_DIR/$id || -L $PLUGINS_DIR/$id ]] || fail "plugin '$id' is not installed"
  is_git_plugin "$id" || fail "'$id' is not a git plugin, and git plugins are all the manager handles"
}

# refuse_self <id> <verb> -- the things the manager will not do to itself.
refuse_self() {
  [[ $1 != "$SELF_ID" ]] || fail "the plugin manager does not $2 itself"
}

plugin_name() {
  local name
  name=$(jq -r '.name // empty' "$PLUGINS_DIR/$1/manifest.json" 2>/dev/null)
  printf '%s\n' "${name:-$1}"
}

# Folder names, which are what omarchy-plugin-update and -remove take. Dot
# folders are the add/remove staging and backup directories.
managed_ids() {
  [[ -d $PLUGINS_DIR ]] || return 0
  local id
  while IFS= read -r id; do
    is_git_plugin "$id" && printf '%s\n' "$id"
  done < <(find "$PLUGINS_DIR" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' | sort)
  return 0
}

# ------------------------------------------------------------------ cache

read_cache() {
  if [[ -s $CACHE ]] && jq -e 'type == "object"' "$CACHE" >/dev/null 2>&1; then
    cat "$CACHE"
  else
    echo '{"plugins":{}}'
  fi
}

# update_cache [jq-args...] <filter> -- applies filter to the cache under a
# lock, since the overlay and a bar widget per monitor can all write it.
#
# The new content is built aside but written over the old file rather than
# renamed onto it: the bar widget's FileView watches the file, and a rename
# swaps the inode out from under the watch so the badge never hears of it.
update_cache() {
  mkdir -p "$CACHE_DIR"
  (
    flock 9
    tmp=$(mktemp "$CACHE_DIR/.updates.XXXXXX")
    if read_cache | jq "$@" >"$tmp"; then
      cat "$tmp" >"$CACHE"
    fi
    rm -f "$tmp"
  ) 9>"$CACHE_DIR/cache.lock"
}

# ------------------------------------------------------------------- list

git_info() {
  local dir="$1" remote branch line dirty=false
  remote=$(git -C "$dir" remote get-url origin 2>/dev/null)
  branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
  line=$(git -C "$dir" log -1 --format='%h%x1f%H%x1f%cI%x1f%s' 2>/dev/null)
  # Untracked files do not stop a fast-forward; changed tracked files do.
  [[ -z $(git -C "$dir" status --porcelain --untracked-files=no 2>/dev/null) ]] || dirty=true
  jq -cn --arg remote "$remote" --arg branch "$branch" --arg line "$line" --argjson dirty "$dirty" '
    ($line | split("\u001f")) as $c
    | { remote: $remote, branch: $branch, commit: ($c[0] // ""), fullCommit: ($c[1] // ""),
        date: ($c[2] // ""), subject: ($c[3] // ""), dirty: $dirty }'
}

plugin_json() {
  local id="$1"
  local dir="$PLUGINS_DIR/$1"
  local manifest="$dir/manifest.json"
  local validation valid=true m='{}' bins

  validation=$(omarchy-plugin-validate "$dir" 2>&1) || valid=false
  if [[ -f $manifest ]]; then
    m=$(jq -c 'if type == "object" then . else {} end' "$manifest" 2>/dev/null) || m='{}'
    [[ -n $m ]] || m='{}'
  fi
  # The scripts a plugin ships, which its shortcuts and menu entries may call
  # instead of naming the plugin's id.
  bins=$(find "$dir/bin" -maxdepth 1 -type f -perm -u+x -printf '%f\n' 2>/dev/null | jq -R . | jq -cs .)

  jq -cn --arg id "$id" --arg dir "$dir" --arg self "$SELF_ID" \
    --argjson valid "$valid" --arg validation "${validation#omarchy-plugin-validate: }" \
    --argjson m "$m" --argjson git "$(git_info "$dir")" --argjson bins "${bins:-[]}" '
    def str(v): if (v | type) == "string" then v else "" end;
    { id: $id,
      self: ($id == $self),
      manifestId: str($m.id),
      name: (str($m.name) | if . == "" then $id else . end),
      version: str($m.version),
      author: str($m.author),
      license: str($m.license),
      description: str($m.description),
      kinds: (if ($m.kinds | type) == "array" then $m.kinds else [] end),
      path: $dir,
      bins: $bins,
      valid: $valid,
      validationError: (if $valid then "" else $validation end),
      git: $git }'
}

# ---------------------------------------------------------------- opening

# How each plugin can be opened: its shortcuts, its Omarchy menu entries and
# its place in the bar. Hyprland cannot say what a binding runs -- with a Lua
# config it only holds a function reference -- so shortcuts are read from
# ~/.config/hypr/*.lua as the plain one-line
#   o.bind("KEYS", "Description", "command")
# that Omarchy writes, then matched against Hyprland's live bindings by keys and
# description to tell which are in effect. A binding built by Lua code instead
# is not found.

HYPR_DIR="$HOME/.config/hypr"
BINDINGS="$HYPR_DIR/bindings.lua"
BINDINGS_BACKUP="$HYPR_DIR/bindings.lua.plugin-manager.bak"
MENU_DEFAULTS="${OMARCHY_PATH:-/usr/share/omarchy}/default/omarchy/omarchy-menu.jsonc"
MENU_USER="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
BIND_MARK="bound by Plugin Manager"

# [{keys, description, command, file, line}] for every o.bind line. A line
# commented out does not start with o.bind, so it does not count.
config_binds_json() {
  local files=("$HYPR_DIR"/*.lua)
  [[ -e ${files[0]} ]] || {
    echo '[]'
    return
  }
  grep -Hn 'o\.bind(' "${files[@]}" 2>/dev/null | jq -Rsc '
    [ split("\n")[]
      | capture("^(?<file>[^:]+):(?<line>[0-9]+):\\s*o\\.bind\\(\\s*\"(?<keys>[^\"]*)\"\\s*,\\s*\"(?<description>[^\"]*)\"\\s*,\\s*\"(?<command>(\\\\.|[^\"\\\\])*)\"")
      | .line |= tonumber
      | .command |= gsub("\\\\(?<c>.)"; .c) ]'
}

# [{file, line, id}] for the comment line above every binding the manager made.
bind_markers_json() {
  local files=("$HYPR_DIR"/*.lua)
  [[ -e ${files[0]} ]] || {
    echo '[]'
    return
  }
  grep -Hn -e "^-- .*, $BIND_MARK\$" "${files[@]}" 2>/dev/null | jq -Rsc --arg mark "$BIND_MARK" '
    [ split("\n")[]
      | capture("^(?<file>[^:]+):(?<line>[0-9]+):-- .*\\((?<id>[^()]+)\\), " + $mark + "$")
      | .line |= tonumber ]'
}

# Hyprland's live bindings, or null when it cannot be asked.
live_binds_json() {
  local out
  if out=$(hyprctl binds -j 2>/dev/null) && jq -e 'type == "array"' >/dev/null 2>&1 <<<"$out"; then
    jq -c '[.[] | {modmask, key: (.key // ""), description: (.description // "")}]' <<<"$out"
  else
    echo null
  fi
}

# Every menu entry as {id: entry}, the user's extension merged over the
# defaults the way the menu merges them. Both files keep one entry per line,
# which is what lets them be read here without a JSONC parser.
menu_entries_json() {
  cat "$MENU_DEFAULTS" "$MENU_USER" 2>/dev/null | jq -Rsc '
    [ split("\n")[]
      | capture("^\\s*\"(?<id>[^\"]+)\"\\s*:\\s*(?<entry>\\{.*\\})\\s*,?\\s*$")
      | .entry |= (try fromjson catch null)
      | select(.entry | type == "object") ]
    | reduce .[] as $e ({}; .[$e.id] = ((.[$e.id] // {}) + $e.entry))'
}

cmd_list() {
  local shell_plugins cache config id
  local items=()

  # One call for every plugin's enabled bit. Without a running shell there is
  # nothing to read it from, and every plugin reads as disabled.
  shell_plugins=$(omarchy-shell shell listPlugins 2>/dev/null)
  jq -e 'type == "array"' <<<"$shell_plugins" >/dev/null 2>&1 || shell_plugins='[]'
  cache=$(read_cache)
  config=$(jq -c 'if type == "object" then . else {} end' "$HOME/.config/omarchy/shell.json" 2>/dev/null)
  [[ -n $config ]] || config='{}'

  while IFS= read -r id; do
    [[ -n $id ]] && items+=("$(plugin_json "$id")")
  done < <(managed_ids)

  printf '%s\n' "${items[@]}" | jq -cs --argjson shell "$shell_plugins" --argjson cache "$cache" \
    --argjson binds "$(config_binds_json)" --argjson markers "$(bind_markers_json)" \
    --argjson live "$(live_binds_json)" --argjson menu "$(menu_entries_json)" \
    --argjson config "$config" --arg braces "'{}'" "$JQ_KEYS"'
    def eid: if type == "object" then (.id // "") else tostring end;
    def esc: gsub("(?<c>[.*+?^$()\\[\\]{}|\\\\])"; "\\\(.c)");
    # A command belongs to a plugin when it names its id or runs one of its scripts.
    def mentions($p):
      . as $cmd
      | ($cmd | contains($p.id))
        or any(($p.bins // [])[]; . as $b | $cmd | test("(^|[^A-Za-z0-9._-])" + ($b | esc) + "([^A-Za-z0-9._-]|$)"));
    # "setup.plugin.manage" as the labels a user clicks through: Setup › Plugins › Manage Plugins.
    def menupath($id):
      $id | split(".") as $parts
      | [range(1; ($parts | length) + 1) | $parts[0:.] | join(".") | ($menu[.].label // .)]
      | join(" › ");

    map(. as $p
        | .enabled = any($shell[]; (.id == $p.id or .id == $p.manifestId) and .enabled == true)
        | .update = ($cache.plugins[$p.id] // null)
        | [ $binds[]
            | select(.command | mentions($p))
            | . as $b
            | (.keys | combo) as $c
            | . + {active: (if $live == null then null
                            else any($live[]; .modmask == $c.modmask and (.key | ascii_upcase) == $c.key
                                              and .description == $b.description) end),
                   # The manager made it when its comment sits just above.
                   managed: any($markers[]; .id == $p.id and .file == $b.file
                                            and ($b.line - .line) >= 1 and ($b.line - .line) <= 2)} ] as $shortcuts
        | [ $menu | to_entries[]
            | select((.value.action | type) == "string" and (.value.action | mentions($p)))
            | {path: menupath(.key), action: .value.action} ] as $entries
        | [ ("left", "center", "right") as $section
            | (($config.bar.layout // {})[$section] // [])[]
            | select(eid == $p.id)
            | {section: $section} ] as $bar
        | .opens = {shortcuts: $shortcuts, menu: $entries, bar: $bar}
        # What Open runs: what its own shortcut or menu entry runs, else a toggle
        # for anything with a window to show, else nothing.
        | .openCommand = (
            ([$shortcuts[] | select(.active != false) | .command] + [$entries[].action]) as $commands
            | if ($commands | length) > 0 then $commands[0]
              elif any(.kinds[]; . == "overlay" or . == "panel" or . == "menu")
              then "omarchy-shell shell toggle \($p.id) \($braces)"
              else "" end))
    | sort_by(.name | ascii_downcase)
    | {ok: true, checkedAt: ($cache.checkedAt // null), plugins: .}'
}

# ------------------------------------------------------------------ check

# check_one <id> [fetch] -- one cache entry. With fetch=0 it compares against
# the FETCH_HEAD already on disk, which is what an update just left behind.
check_one() {
  local id="$1" fetch="${2:-1}"
  local dir="$PLUGINS_DIR/$1"
  local now err="" behind=0 ahead=0 commits='[]' version=""
  now=$(date -Iseconds)

  # The same fetch omarchy-plugin-update does, so "behind" here means exactly
  # what an update would bring in.
  if ((fetch)) && ! err=$(git -C "$dir" fetch --quiet origin HEAD 2>&1); then
    # git's reason is its fatal: line; what follows is boilerplate such as
    # "and the repository exists."
    err=$(sed -n 's/^\(fatal\|error\): //p' <<<"$err" | head -n 1)
    err="${err:-fetch failed}"
  elif ! git -C "$dir" rev-parse -q --verify FETCH_HEAD >/dev/null; then
    err="not checked yet"
  else
    err=""
    behind=$(git -C "$dir" rev-list --count HEAD..FETCH_HEAD 2>/dev/null || echo 0)
    ahead=$(git -C "$dir" rev-list --count FETCH_HEAD..HEAD 2>/dev/null || echo 0)
    commits=$(git -C "$dir" log -n "$MAX_COMMITS" --format='%h%x1f%cI%x1f%an%x1f%s' HEAD..FETCH_HEAD 2>/dev/null |
      jq -cR 'split("\u001f") | {commit: .[0], date: .[1], author: .[2], subject: .[3]}' | jq -cs .)
    version=$(git -C "$dir" show FETCH_HEAD:manifest.json 2>/dev/null | jq -r '.version // empty' 2>/dev/null)
  fi

  jq -cn --arg now "$now" --arg err "$err" --argjson behind "${behind:-0}" --argjson ahead "${ahead:-0}" \
    --argjson commits "${commits:-[]}" --arg version "$version" '
    {behind: $behind, ahead: $ahead, commits: $commits,
     remoteVersion: $version, error: $err, checkedAt: $now}'
}

# Tell the desktop about plugins that have an update now and did not at the
# last notification, so a plugin is announced once per update, not per check.
notify_updates() {
  local state id names=() body count
  state=$(read_cache | jq -c '
    [(.plugins // {}) | to_entries[] | select((.value.error // "") == "" and (.value.behind // 0) > 0) | .key] as $now
    | {now: $now, new: ($now - (.notified // []))}')
  update_cache --argjson now "$(jq -c '.now' <<<"$state")" '.notified = $now'

  while IFS= read -r id; do
    [[ -n $id ]] && names+=("$(plugin_name "$id")")
  done < <(jq -r '.new[]' <<<"$state")
  count=${#names[@]}
  ((count > 0)) || return 0

  if ((count == 1)); then
    body="${names[0]} has an update"
  elif ((count == 2)); then
    body="${names[0]} and ${names[1]} have updates"
  else
    body="${names[0]}, ${names[1]} and $((count - 2)) more have updates"
  fi

  # Clicking it opens the manager.
  if command -v omarchy-notification-send >/dev/null; then
    omarchy-notification-send -g "$PLUGIN_GLYPH" -u normal "Plugin updates" "$body" \
      --exec omarchy-shell shell summon "$SELF_ID" '{}' >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null; then
    notify-send -a "Plugin Manager" "Plugin updates" "$body" >/dev/null 2>&1 || true
  fi
}

cmd_check() {
  local only="" stale="" notify=0 id at
  while (($# > 0)); do
    case "$1" in
    --if-stale)
      stale="${2:-}"
      [[ $stale =~ ^[0-9]+$ ]] || fail "--if-stale needs a number of seconds"
      shift 2
      ;;
    --notify)
      notify=1
      shift
      ;;
    -*) fail "unknown check option: $1" ;;
    *)
      [[ -z $only ]] || fail "unexpected argument: $1"
      only="$1"
      shift
      ;;
    esac
  done
  [[ -z $only ]] || require_managed "$only"

  # One check at a time. A bar widget on every monitor fires its timer at
  # once, and the manager checks when it opens; the second one waits here and
  # then finds the cache fresh.
  mkdir -p "$CACHE_DIR"
  exec 8>"$CACHE_DIR/check.lock"
  flock 8

  if [[ -n $stale && -z $only ]]; then
    at=$(read_cache | jq -r '.checkedAt // empty')
    if [[ -n $at ]] && (($(date +%s) - $(date -d "$at" +%s 2>/dev/null || echo 0) < stale)); then
      read_cache | jq -c '{ok: true} + .'
      return
    fi
  fi

  local ids=()
  if [[ -n $only ]]; then
    ids=("$only")
  else
    mapfile -t ids < <(managed_ids)
  fi

  # Fetch in parallel: each one is mostly waiting on the network.
  local tmpd entries
  tmpd=$(mktemp -d)
  for id in "${ids[@]}"; do
    check_one "$id" >"$tmpd/$id" &
  done
  wait
  entries=$(for id in "${ids[@]}"; do jq -c --arg id "$id" '{($id): .}' "$tmpd/$id"; done | jq -cs 'add // {}')
  rm -rf "$tmpd"

  if [[ -n $only ]]; then
    update_cache --argjson e "$entries" '.plugins = ((.plugins // {}) + $e)'
  else
    # A full check replaces the list, which drops plugins removed since.
    update_cache --argjson e "$entries" --arg now "$(date -Iseconds)" '.plugins = $e | .checkedAt = $now'
    ((notify)) && notify_updates
  fi
  read_cache | jq -c '{ok: true} + .'
}

# review <id> -- what an update would bring in, fetched fresh: the commits, the
# files it changes and the diff itself, cut off after MAX_DIFF_LINES lines.
cmd_review() {
  local id="${1:-}" dir entry err behind name files total tmp message
  require_managed "$id"
  dir="$PLUGINS_DIR/$id"
  name=$(plugin_name "$id")

  entry=$(check_one "$id")
  update_cache --arg id "$id" --argjson e "$entry" '.plugins[$id] = $e'
  err=$(jq -r '.error' <<<"$entry")
  [[ -z $err ]] || fail "Could not check $name: $err"
  behind=$(jq -r '.behind' <<<"$entry")

  tmp=$(mktemp)
  if ((behind > 0)); then
    files=$(git -C "$dir" diff --numstat HEAD FETCH_HEAD 2>/dev/null | jq -Rsc '
      [ split("\n")[] | select(length > 0) | split("\t")
        | {path: .[2], added: ((.[0] | tonumber?) // null), deleted: ((.[1] | tonumber?) // null)} ]')
    total=$(git -C "$dir" diff --no-color HEAD FETCH_HEAD 2>/dev/null | wc -l)
    git -C "$dir" diff --no-color HEAD FETCH_HEAD 2>/dev/null | head -n "$MAX_DIFF_LINES" >"$tmp"
    message="$(plural "$behind" "new commit"), $(plural "$(jq 'length' <<<"$files")" "file") changed"
  else
    files='[]'
    total=0
    message="$name is up to date"
  fi

  # Built here rather than through reply: a diff is too long to pass as an
  # argument, so it is read from the file.
  jq -cn --arg id "$id" --arg name "$name" --arg message "$message" --argjson entry "$entry" \
    --argjson files "${files:-[]}" --argjson total "${total:-0}" --argjson max "$MAX_DIFF_LINES" \
    --rawfile diff "$tmp" '
    {ok: true, message: $message, output: "", id: $id, name: $name, entry: $entry,
     files: $files, diff: $diff, totalLines: $total, truncated: ($total > $max)}'
  rm -f "$tmp"
}

# ---------------------------------------------------------------- actions

# run_stock <success-message> <id-for-reply> <command...>
run_stock() {
  local message="$1" id="$2" out
  shift 2
  if out=$("$@" 2>&1 </dev/null); then
    reply true "${message:-$(last_line "$out")}" "$out" "$(jq -cn --arg id "$id" '{id: $id}')"
  else
    reply false "$(last_line "$out")" "$out" "$(jq -cn --arg id "$id" '{id: $id}')"
    return 1
  fi
}

cmd_update() {
  local id="${1:-}"
  require_managed "$id"
  run_stock "" "$id" omarchy-plugin-update "$id" --yes || return 1
  update_cache --arg id "$id" --argjson e "$(check_one "$id" 0)" '.plugins[$id] = $e'
}

cmd_remove() {
  local id="${1:-}"
  require_managed "$id"
  refuse_self "$id" remove
  run_stock "" "$id" omarchy-plugin-remove "$id" --yes || return 1
  update_cache --arg id "$id" 'del(.plugins[$id])'
}

cmd_add() {
  local url="${1:-}" out id
  [[ -n $url ]] || fail "a git URL is required"
  # Lands disabled: plugins run unsandboxed in omarchy-shell, and Omarchy's
  # model is to read the code before switching it on.
  if out=$(omarchy-plugin-add "$url" --yes 2>&1 </dev/null); then
    id=$(sed -n 's/^Added \(.*\) into .*/\1/p' <<<"$out" | tail -n 1)
    reply true "Added ${id:-the plugin}. It stays disabled until you enable it." "$out" \
      "$(jq -cn --arg id "$id" '{id: $id}')"
  else
    reply false "$(last_line "$out")" "$out"
    return 1
  fi
}

cmd_enable() {
  local id="${1:-}"
  require_managed "$id"
  refuse_self "$id" "switch on"
  run_stock "" "$id" omarchy-plugin-enable "$id"
}

cmd_disable() {
  local id="${1:-}"
  require_managed "$id"
  refuse_self "$id" "switch off"
  run_stock "" "$id" omarchy-plugin-disable "$id"
}

# -------------------------------------------------------------- shortcuts

# A binding the manager makes is a block in ~/.config/hypr/bindings.lua:
#
#   -- Default Applications (io.github.kimm-stensborg.default-apps), bound by Plugin Manager
#   o.bind("SUPER + ALT + D", "Default Applications", "omarchy-shell shell toggle …")
#
# with an hl.unbind line between the two when it took over a combination
# something else had. The comment is how it finds its own blocks again; it
# never edits a binding it did not make.

# The keys of the binding the manager made for a plugin, if it made one.
own_bind_keys() {
  jq -rn --argjson binds "$(config_binds_json)" --argjson markers "$(bind_markers_json)" --arg id "$1" "$JQ_KEYS"'
    [ $markers[] | select(.id == $id) as $m
      | $binds[] | select(.file == $m.file and (.line - $m.line) >= 1 and (.line - $m.line) <= 2)
      | .keys | combo | keylabel ] | .[0] // ""'
}

# keycheck <keys> [id] -- the one spelling of a combination, and what Hyprland
# already has on it. The binding the manager made for <id> does not count
# against it: moving a shortcut onto itself is no conflict.
cmd_keycheck() {
  local keys="${1:-}" id="${2:-}" own=""
  [[ -n $id ]] && own=$(own_bind_keys "$id")
  jq -cn --arg keys "$keys" --argjson live "$(live_binds_json)" --arg own "$own" "$JQ_KEYS"'
    ($keys | combo) as $c
    | if $c.modmask == 0 or ($c.single | not) then
        {ok: false, message: "Use one or more modifiers and one key, like SUPER + ALT + D"}
      else
        ($c | keylabel) as $label
        | (takenby($live; $c) | .[0]) as $hit
        | {ok: true, keys: $label, known: ($live != null),
           taken: ($hit != null and $label != $own),
           takenBy: (if $hit != null and $label != $own then ($hit.description // "") else "" end)}
      end'
}

# suggest-key <id> -- the first free combination made from the plugin's name:
# its initials first, then its other letters, each tried with the modifiers
# Omarchy leaves mostly free.
cmd_suggest_key() {
  local id="${1:-}"
  require_managed "$id"
  jq -cn --arg name "$(plugin_name "$id")" --argjson live "$(live_binds_json)" \
    --arg own "$(own_bind_keys "$id")" "$JQ_KEYS"'
    ($name | ascii_upcase | [scan("[A-Z0-9]+")]) as $words
    | ([$words[] | .[0:1]] + [$words[] | explode[] | [.] | implode]
       | reduce .[] as $l ([]; if index($l) == null then . + [$l] else . end)) as $letters
    | [ $letters[] as $l
        | ("SUPER + ALT", "SUPER + CTRL", "SUPER + CTRL + SHIFT", "SUPER + SHIFT + ALT")
        | ("\(.) + \($l)" | combo) as $c
        | ($c | keylabel) as $label
        | select((takenby($live; $c) | length) == 0 or $label == $own)
        | $label ] as $free
    | if ($free | length) > 0 then {ok: true, keys: $free[0]}
      else {ok: false, message: "None of the usual combinations is free; type one"} end'
}

# The file without the manager's block for <id>; exits 3 when there was none.
strip_bind_block() {
  awk -v id="$1" -v mark="$BIND_MARK" '
    index($0, "-- ") == 1 && index($0, "(" id "), " mark) > 0 && substr($0, length($0) - length(mark) + 1) == mark {
      skip = 1; found = 1; next
    }
    skip && ($0 ~ /^hl\.unbind\(/ || $0 ~ /^o\.bind\(/) { next }
    { skip = 0; lines[++n] = $0 }
    END {
      while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--
      for (i = 1; i <= n; i++) print lines[i]
      exit(found ? 0 : 3)
    }' "$2"
}

lua_string() {
  sed 's/\\/\\\\/g; s/"/\\"/g' <<<"$1"
}

# Reload Hyprland and keep the change only if it takes it without complaint;
# otherwise put the file back as it was and print what Hyprland said.
apply_hypr_config() {
  local errors
  hyprctl reload >/dev/null 2>&1
  errors=$(hyprctl configerrors 2>/dev/null)
  if [[ -n ${errors//[[:space:]]/} && $errors != "no errors"* ]]; then
    cat "$BINDINGS_BACKUP" >"$BINDINGS"
    hyprctl reload >/dev/null 2>&1
    printf '%s\n' "$errors"
    return 1
  fi
}

# write_binding <id> <name> <keys> <command> <unbind-first>
write_binding() {
  local id="$1" name="${2//$'\n'/ }" keys="$3" command="$4" unbind="$5" tmp
  mkdir -p "$HYPR_DIR"
  touch "$BINDINGS"
  cp "$BINDINGS" "$BINDINGS_BACKUP"
  tmp=$(mktemp)
  strip_bind_block "$id" "$BINDINGS" >"$tmp"
  {
    printf '\n-- %s (%s), %s\n' "$name" "$id" "$BIND_MARK"
    ((unbind)) && printf 'hl.unbind("%s")\n' "$keys"
    printf 'o.bind("%s", "%s", "%s")\n' "$keys" "$(lua_string "$name")" "$(lua_string "$command")"
  } >>"$tmp"
  # Written in place, the way the rest of the config is edited.
  cat "$tmp" >"$BINDINGS"
  rm -f "$tmp"
  apply_hypr_config
}

# bind <id> <keys> [--replace] -- bind a combination to what Open runs for the
# plugin. A combination something else has is refused unless --replace, which
# unbinds it first.
cmd_bind() {
  local id="" keys="" replace=0
  while (($# > 0)); do
    case "$1" in
    --replace)
      replace=1
      shift
      ;;
    -*) fail "unknown bind option: $1" ;;
    *)
      if [[ -z $id ]]; then id="$1"; elif [[ -z $keys ]]; then keys="$1"; else fail "unexpected argument: $1"; fi
      shift
      ;;
    esac
  done
  require_managed "$id"
  [[ -n $keys ]] || fail "a key combination is required"

  local plugin name command check label taken=0 errors
  plugin=$(cmd_list | jq -c --arg id "$id" '.plugins[] | select(.id == $id)')
  name=$(jq -r '.name' <<<"$plugin")
  command=$(jq -r '.openCommand' <<<"$plugin")
  [[ -n $command ]] || fail "$name has no window to open, so there is nothing to bind"

  check=$(cmd_keycheck "$keys" "$id")
  jq -e '.ok' >/dev/null <<<"$check" || {
    printf '%s\n' "$check"
    return 1
  }
  label=$(jq -r '.keys' <<<"$check")
  jq -e '.taken' >/dev/null <<<"$check" && taken=1
  if ((taken && !replace)); then
    reply false "$label is taken by $(jq -r '.takenBy | if . == "" then "another binding" else . end' <<<"$check")" "" \
      "$(jq -c '{keys, taken, takenBy}' <<<"$check")"
    return 1
  fi

  if ! errors=$(write_binding "$id" "$name" "$label" "$command" "$taken"); then
    reply false "Hyprland rejected the binding, so it was not kept: $(last_line "$errors")" "$errors"
    return 1
  fi
  reply true "Bound $label to $name" "" "$(jq -cn --arg id "$id" --arg keys "$label" '{id: $id, keys: $keys}')"
}

cmd_unbind() {
  local id="${1:-}" tmp name
  [[ -n $id ]] && valid_id "$id" || fail "a plugin id is required"
  name=$(plugin_name "$id")
  [[ -f $BINDINGS ]] || fail "there is no shortcut the manager made for $name"
  cp "$BINDINGS" "$BINDINGS_BACKUP"
  tmp=$(mktemp)
  if ! strip_bind_block "$id" "$BINDINGS" >"$tmp"; then
    rm -f "$tmp"
    fail "there is no shortcut the manager made for $name"
  fi
  cat "$tmp" >"$BINDINGS"
  rm -f "$tmp"
  apply_hypr_config >/dev/null || fail "Hyprland rejected the change, so the shortcut was left as it was"
  reply true "Removed the shortcut for $name" "" "$(jq -cn --arg id "$id" '{id: $id}')"
}

# ---------------------------------------------------------- export/import

# The export is a list of git URLs, so it only carries what another machine can
# clone: a git plugin whose remote is a path on this disk, or that has no
# remote at all, is listed under "skipped" with the reason. The manager itself
# is left out; the other machine needs it installed to import anything.
#
# Each plugin records whether it was enabled and where: every bar instance with
# its section, index, neighbours and inline settings, the inline settings of a
# plugins[] entry, or whether it was the bar itself.

EXPORT_FORMAT="omarchy-plugin-manager"

cmd_export() {
  local file="${1:-}" listing config out count skipped
  [[ -n $file ]] || file="$HOME/omarchy-plugins-$(uname -n)-$(date +%Y%m%d).json"
  file="${file/#\~/$HOME}"

  listing=$(cmd_list) || fail "could not list the plugins"
  config=$(jq -c 'if type == "object" then . else {} end' "$HOME/.config/omarchy/shell.json" 2>/dev/null)
  [[ -n $config ]] || config='{}'

  out=$(jq -n --argjson list "$listing" --argjson config "$config" --arg format "$EXPORT_FORMAT" \
    --arg now "$(date -Iseconds)" --arg host "$(uname -n)" --arg omarchy "$(omarchy version 2>/dev/null | head -n 1)" '
    def eid: if type == "object" then (.id // "") else tostring end;
    def portable: test("^(https?|ssh|git)://.") or test("^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+:.");
    def placements($layout; $id):
      [ ("left", "center", "right") as $section
        | ($layout[$section] // []) as $entries
        | range(0; $entries | length) as $i
        | select(($entries[$i] | eid) == $id)
        | { section: $section,
            index: $i,
            after: (if $i > 0 then ($entries[$i - 1] | eid) else null end),
            before: (if $i + 1 < ($entries | length) then ($entries[$i + 1] | eid) else null end),
            settings: ($entries[$i] | if type == "object" then del(.id) else {} end) } ];
    def skip($p; $reason): {skip: {id: $p.id, name: $p.name, reason: $reason}};

    ($config.bar.layout // {}) as $layout
    | [ $list.plugins[]
        | select(.self | not)
        | . as $p
        | ($p.git.remote // "") as $remote
        | if $remote == "" then skip($p; "it has no remote to fetch it from")
          elif ($remote | portable | not) then skip($p; "its remote is a path on this machine")
          else
            { plugin: {
                id: $p.id, name: $p.name, version: $p.version, url: $remote,
                branch: $p.git.branch, commit: $p.git.fullCommit, enabled: $p.enabled,
                bar: ((($config.bar.id // "") | tostring) == $p.id),
                placements: placements($layout; $p.id),
                settings: (([($config.plugins // [])[] | select(type == "object" and .id == $p.id) | del(.id)] | .[0]) // {}) } }
          end ]
    | { format: $format, version: 1, exportedAt: $now, host: $host, omarchyVersion: $omarchy,
        plugins: [.[] | .plugin // empty],
        skipped: [.[] | .skip // empty] }') || fail "could not build the export"

  mkdir -p "$(dirname "$file")" || fail "cannot create $(dirname "$file")"
  printf '%s\n' "$out" | jq . >"$file" || fail "cannot write $file"

  count=$(jq '.plugins | length' <<<"$out")
  skipped=$(jq '.skipped | length' <<<"$out")
  local message="Exported $count plugin$( ((count == 1)) || echo s) to ${file/#$HOME/\~}"
  ((skipped == 0)) || message+=" · $skipped skipped"
  reply true "$message" "" "$(jq -c --arg path "$file" '{path: $path, exported: (.plugins | length), skipped: .skipped}' <<<"$out")"
}

# Every folder in the plugin directory, git or not and the manager included:
# an import must not try to add what is already here under any name.
installed_json() {
  [[ -d $PLUGINS_DIR ]] || {
    echo '[]'
    return
  }
  find "$PLUGINS_DIR" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) ! -name '.*' -printf '%f\n' | jq -R . | jq -cs .
}

# Wait for the shell to have scanned a freshly added plugin; enabling one it has
# not seen yet is refused as unknown.
wait_known() {
  local id="$1" i
  for ((i = 0; i < 50; i++)); do
    omarchy-plugin-list --json 2>/dev/null | jq -e --arg id "$id" 'any(.[]; .id == $id)' >/dev/null && return 0
    sleep 0.1
  done
  return 1
}

# A plugins[] entry's inline settings. The shell has no IPC for these, so they
# go into shell.json directly -- written in place, like the shell's own writes
# -- and the shell is asked to read it again. Enabling has already added the
# entry; should it be missing, it is added here rather than lost.
apply_entry_settings() {
  local id="$1" settings="$2" config="$HOME/.config/omarchy/shell.json" tmp
  [[ -f $config ]] || return 1
  tmp=$(mktemp)
  if jq --arg id "$id" --argjson s "$settings" '
    .plugins = ((.plugins // [])
      | if any(.[]; type == "object" and .id == $id)
        then map(if type == "object" and .id == $id then ({id: $id} + $s) else . end)
        else . + [{id: $id} + $s] end)' "$config" >"$tmp"; then
    cat "$tmp" >"$config"
  fi
  rm -f "$tmp"
  omarchy-shell shell reloadConfig >/dev/null 2>&1
}

# restore_enabled <id> <exported-plugin-json> -- switch a just-added plugin on
# the way it was exported. Prints what it did; returns 1 with the reason.
restore_enabled() {
  local id="$1" entry="$2" placement result key value i
  wait_known "$id" || {
    echo "the shell did not pick it up"
    return 1
  }

  if jq -e '.bar == true' >/dev/null <<<"$entry"; then
    omarchy-plugin-enable "$id" >/dev/null 2>&1 || {
      echo "could not make it the bar"
      return 1
    }
    echo "enabled as the bar"
    return 0
  fi

  if jq -e '(.placements // []) | length > 0' >/dev/null <<<"$entry"; then
    # Next to the widget it sat beside, when this bar has that widget too;
    # putBarWidget drops a neighbour it cannot find and keeps the section.
    placement=$(jq -c '.placements[0] | {section}
      + (if .after then {after} elif .before then {before} else {index} end)' <<<"$entry")
    for ((i = 0; i < 40; i++)); do
      result=$(omarchy-shell shell putBarWidget "$id" "$placement" 2>&1)
      [[ $result == "not ready" ]] || break
      sleep 0.1
    done
    [[ $result == ok ]] || {
      echo "could not put it on the bar: $result"
      return 1
    }
    while IFS=$'\t' read -r key value; do
      [[ -n $key ]] || continue
      omarchy-shell shell setBarWidget "$id" "$key" "$value" '{}' >/dev/null 2>&1
    done < <(jq -r '.placements[0].settings // {} | to_entries[] | [.key, (.value | tojson)] | @tsv' <<<"$entry")
    echo "enabled in the $(jq -r '.placements[0].section' <<<"$entry") section"
    return 0
  fi

  omarchy-plugin-enable "$id" >/dev/null 2>&1 || {
    echo "could not enable it"
    return 1
  }
  if jq -e '(.settings // {}) | length > 0' >/dev/null <<<"$entry"; then
    apply_entry_settings "$id" "$(jq -c '.settings' <<<"$entry")"
  fi
  echo "enabled"
}

cmd_import() {
  local file="" dry=0 doc plan
  while (($# > 0)); do
    case "$1" in
    --dry-run) dry=1; shift ;;
    -*) fail "unknown import option: $1" ;;
    *)
      [[ -z $file ]] || fail "unexpected argument: $1"
      file="$1"
      shift
      ;;
    esac
  done
  [[ -n $file ]] || fail "an export file is required"
  file="${file/#\~/$HOME}"
  [[ -f $file ]] || fail "there is no file at ${file/#$HOME/\~}"
  doc=$(jq -c --arg format "$EXPORT_FORMAT" 'select(type == "object" and .format == $format and .version == 1)' "$file" 2>/dev/null)
  [[ -n $doc ]] || fail "${file/#$HOME/\~} is not a Plugin Manager export"

  # What happens to each plugin. The file is data from elsewhere, so ids are
  # checked here and URLs by omarchy-plugin-add before anything is cloned.
  plan=$(jq -c --argjson installed "$(installed_json)" '
    [ (.plugins // [])[]
      | select(type == "object")
      | (.id // "" | tostring) as $id
      | { id: $id, name: (.name // $id), url: (.url // ""), enabled: (.enabled == true),
          where: (if .bar == true then "as the bar"
                  elif ((.placements // []) | length) > 0 then "in the \(.placements[0].section) section"
                  else "" end),
          entry: . }
      | if ($id | test("^[A-Za-z0-9][A-Za-z0-9._-]*$") | not) or ($id | contains("..")) then
          . + {action: "skip", reason: "an invalid plugin id"}
        elif ($installed | index($id)) != null then . + {action: "skip", reason: "already installed"}
        elif .url == "" then . + {action: "skip", reason: "no URL to fetch it from"}
        else . + {action: "install"} end ]' <<<"$doc")

  local installing
  installing=$(jq '[.[] | select(.action == "install")] | length' <<<"$plan")

  if ((dry)); then
    local message
    message=$(jq -r '
      ([.[] | select(.action == "install")] | length) as $n
      | ([.[] | select(.action == "skip")] | length) as $s
      | (if $n == 0 then "Nothing to import" else "\($n) plugin\(if $n == 1 then "" else "s" end) to import" end)
        + (if $s > 0 then " · \($s) skipped" else "" end)' <<<"$plan")
    reply true "$message" "" "$(jq -c --argjson plan "$plan" '{
      host, exportedAt, path: $path,
      plan: [$plan[] | del(.entry)],
      skippedAtExport: (.skipped // [])}' --arg path "$file" <<<"$doc")"
    return
  fi

  ((installing > 0)) || {
    reply true "Nothing to import: every plugin in the file is already here or was skipped"
    return
  }

  local item id url out added what ok_count=0 fail_count=0 lines=() failed=()
  while IFS= read -r item; do
    id=$(jq -r '.id' <<<"$item")
    url=$(jq -r '.url' <<<"$item")
    if ! out=$(omarchy-plugin-add "$url" --yes 2>&1 </dev/null); then
      lines+=("✗ $id: $(last_line "$out")")
      failed+=("$id: $(last_line "$out")")
      fail_count=$((fail_count + 1))
      continue
    fi
    added=$(sed -n 's/^Added \(.*\) into .*/\1/p' <<<"$out" | tail -n 1)
    what="added"
    if [[ -n $added && $added != "$id" ]]; then
      what="added as $added (the repo has renamed it)"
      id="$added"
    fi
    if jq -e '.enabled' >/dev/null <<<"$item"; then
      if out=$(restore_enabled "$id" "$(jq -c '.entry' <<<"$item")"); then
        what+=", $out"
      else
        what+=", but $out"
      fi
    fi
    lines+=("✓ $id: $what")
    ok_count=$((ok_count + 1))
  done < <(jq -c '.[] | select(.action == "install")' <<<"$plan")

  local message="Imported $ok_count of $installing plugin$( ((installing == 1)) || echo s)"
  if ((fail_count > 0)); then
    # The first failure goes in the message itself, since that is what the
    # overlay's status line shows; every plugin's line is in the output.
    message+=" · $fail_count failed: ${failed[0]}"
    ((fail_count == 1)) || message+=" (and $((fail_count - 1)) more)"
  fi
  local output
  output=$(printf '%s\n' "${lines[@]}")
  if ((fail_count == 0)); then
    reply true "$message" "$output"
  else
    reply false "$message" "$output"
    return 1
  fi
}

# -------------------------------------------------------------------- run

# run --label L --id ID --kind K -- <command...>
#
# How the overlay runs anything that ends in a shell rescan. A rescan unloads
# every panel, the overlay included, and with it any process it was waiting on;
# so the overlay starts this detached and forgets it. While it works,
# running.json says what is going on; when it is done the reply lands in
# last-action.json and the overlay is summoned back to show it.
#
# Kind self-update is the manager updating itself. The running shell keeps the
# QML it compiled until it restarts, so after a successful update the shell is
# restarted -- which stops only the quickshell processes, not this job -- and
# the manager summoned back into the new one.
cmd_run() {
  local label="" id="" kind="" seq out
  while (($# > 0)); do
    case "$1" in
    --label) label="${2:-}"; shift 2 ;;
    --id) id="${2:-}"; shift 2 ;;
    --kind) kind="${2:-}"; shift 2 ;;
    --) shift; break ;;
    *) fail "unknown run option: $1" ;;
    esac
  done
  (($# > 0)) || fail "run needs a command"

  mkdir -p "$CACHE_DIR"
  exec 7>"$CACHE_DIR/action.lock"
  flock 7

  seq=$(date +%s%N)
  jq -cn --arg seq "$seq" --arg label "$label" --arg id "$id" --arg kind "$kind" --arg now "$(date -Iseconds)" \
    '{seq: $seq, label: $label, id: $id, kind: $kind, startedAt: $now}' >"$CACHE_DIR/running.json.tmp" &&
    mv "$CACHE_DIR/running.json.tmp" "$CACHE_DIR/running.json"

  out=$("${BASH_SOURCE[0]}" "$@")
  jq -e 'type == "object"' >/dev/null 2>&1 <<<"$out" || out=$(reply false "${label:-The action} failed" "$out")

  jq -cn --arg seq "$seq" --arg label "$label" --arg id "$id" --arg kind "$kind" --argjson result "$out" \
    '{seq: $seq, label: $label, id: $id, kind: $kind, result: $result}' >"$CACHE_DIR/last-action.json.tmp" &&
    mv "$CACHE_DIR/last-action.json.tmp" "$CACHE_DIR/last-action.json"
  rm -f "$CACHE_DIR/running.json"

  if [[ -z ${PLUGIN_MANAGER_NO_SUMMON:-} ]]; then
    if [[ $kind == self-update ]] && jq -e '.ok and (.message | startswith("Updated"))' >/dev/null 2>&1 <<<"$out"; then
      omarchy-restart-shell >/dev/null 2>&1 || true
    fi
    resummon "$(jq -cn --arg seq "$seq" '{resume: $seq}')"
  fi
  printf '%s\n' "$out"
}

loaded() {
  [[ $(omarchy-shell shell call "$SELF_ID" ping x 2>/dev/null) == ok ]]
}

# Bring the manager back with a job's result. When the stock command returns,
# its reloads may not have happened yet: the rescan it ended with, and the one
# the file watcher sets off 150ms after it sees a plugin folder come or go. An
# overlay that answers now can still be torn down a moment later, so it only
# counts once it has kept answering for three seconds; until then, whenever it
# is gone, summon it again. An overlay that survives is left alone -- it polls
# last-action.json and shows the result itself.
resummon() {
  local payload="$1" i pause stable
  for ((i = 0; i < 30; i++)); do
    loaded || omarchy-shell shell summon "$SELF_ID" "$payload" >/dev/null 2>&1
    sleep 0.4
    loaded || continue
    stable=1
    for pause in 0.6 1 1.4; do
      sleep "$pause"
      loaded || {
        stable=0
        break
      }
    done
    ((stable)) && return 0
  done
  return 1
}

# ------------------------------------------------------------------- main

command="${1:-}"
(($# > 0)) && shift

case "$command" in
list) cmd_list ;;
check) cmd_check "$@" ;;
review) cmd_review "$@" ;;
update) cmd_update "$@" ;;
remove) cmd_remove "$@" ;;
add) cmd_add "$@" ;;
enable) cmd_enable "$@" ;;
disable) cmd_disable "$@" ;;
suggest-key) cmd_suggest_key "$@" ;;
keycheck) cmd_keycheck "$@" ;;
bind) cmd_bind "$@" ;;
unbind) cmd_unbind "$@" ;;
export) cmd_export "$@" ;;
import) cmd_import "$@" ;;
run) cmd_run "$@" ;;
-h | --help | help)
  # The comment block at the top of this file, however long it grows.
  awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$0"
  ;;
*) fail "unknown command '${command}'; see --help" ;;
esac
